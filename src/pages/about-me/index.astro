---

<MainLayout>
   <Name
    title="王忆天"
    subTitles={[
      "1992.08.20",
      "哈尔滨工业大学 ｜ 软件工程 ｜ 2010 级",
      "11 年开发经验/前端全栈",
      "dandananddada@163.com",
    ]}
  />

  <Experiences
    title=`工作经验`
    tabs={[
      {
        heading: "欧科云链",
        date: '2022.09 - 至今',
        content: OKX,
        first: true,
      },
      {
        heading: "阿里巴巴",
