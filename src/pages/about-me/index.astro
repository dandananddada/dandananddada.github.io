const neighborSystem = [
  {
    title: "前端开发组",
    tasks: [
      "负责公司前端项目管理，管理 9 人。",
      "负责 Web 项目管理开发，采用 Laravel 构建韩乐坊官方站点。",
      "参考 Wordpress 产品设计，采用 Rails 实现内容发布系统。",
      "业余时间承接私人项目，足球博彩、留学咨询、共享网等。",
      "共享网宗旨是资源互换与共享，主要通过旧物换新，二次加工的形式实现盈利，初期以旧衣服换取话费、电影票、超市充值卡、运费服务等形式拉取用户资源，后对旧衣进行加工、翻新处理实现盈利。",
