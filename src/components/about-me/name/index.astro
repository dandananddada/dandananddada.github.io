---

interface Props {
  title?: string;
  subTitles?: string[];
}
// Define props from Astro
const { title, subTitles } = Astro.props;
---

<section
  class="mx-auto max-w-[85rem] p-4 sm:px-6 lg:px-8 2xl:max-w-full"
>

  <!-- Displaying the main content consisting of title, subtitle, and several `IconBlock` components -->
  <div class="p-4 lg:px-16">
    <!-- Block for title and subtitle -->
    <div class="lg:col-span-12">
      <!-- Rendering title -->
      <h2
        class="text-balance text-2xl font-bold text-neutral-800 dark:text-neutral-200 md:text-3xl"
      >
        {title}
      </h2>
      <!-- Rendering subtitle -->
      {
        subTitles && (
          subTitles.map((subTitle) => (
            <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400 md:mt-4">
              {subTitle}
            </p>
          ))
        )
      }
    </div>
  </div>
</section>
